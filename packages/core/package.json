{
  "name": "@repo/core",
  "version": "1.0.0",
  "description": "Manage auth & database instances, schemas, and more",
  "exports": {
    "./auth/*": {
      "types": "./dist/auth/*.d.ts",
      "default": "./dist/auth/*.js"
    },
    "./database/*": {
      "types": "./dist/database/*.d.ts",
      "default": "./dist/database/*.js"
    },
    "./zod/*": {
      "types": "./dist/zod/*.d.ts",
      "default": "./dist/zod/*.js"
    },
    "./queries/*": {
      "types": "./dist/queries/*.d.ts",
      "default": "./dist/queries/*.js"
    }
  },
  "scripts": {
    "better-auth:generate": "npx @better-auth/cli@latest generate --config ./config/auth.ts --output ./src/database/schemas/auth.schema.ts",
    "build": "tsc -p tsconfig.json --outDir ./dist && tsc-alias",
    "drizzle:generate": "drizzle-kit generate --config drizzle.config.ts",
    "drizzle:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "drizzle:studio": "drizzle-kit studio --config drizzle.config.ts",
    "drizzle:studio:local": "drizzle-kit studio --config drizzle.config.local.ts",
    "pull": "drizzle-kit pull --config drizzle.config.ts"
  },
  "keywords": [],
  "author": "iamVihanga",
  "license": "ISC",
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "@paralleldrive/cuid2": "^2.2.2",
    "better-auth": "^1.3.16",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.44.5",
    "drizzle-zod": "^0.8.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250924.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite#": "link:@types/better-sqlite#",
    "drizzle-kit": "^0.31.4",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.2"
  }
}
